        <PAGEOBJECT XPOS="154" YPOS="1754" OwnPage="3" ItemID="397793301" PTYPE="4" WIDTH="240" HEIGHT="660" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" ANNAME="p4-left" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L240 0 L240 660 L0 660 L0 0 Z" copath="M0 0 L240 0 L240 660 L0 660 L0 0 Z" gXpos="154" gYpos="1754" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="397796373" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT CH="CHAPTER 1: THE MOUNTAINVIEW REST"/>
                <para PARENT="Heading 1"/>
                <ITEXT CH="[Chapter introduction. Set the scene: where the characters are, what has brought them here, and what is at stake. Two or three paragraphs is plenty — the encounters below carry the detail.]"/>
                <para PARENT="Body First"/>
                <ITEXT CH="[A second paragraph of introduction, if needed. The mood of the place, the weather, the sounds and smells — the texture the players will remember.]"/>
                <para PARENT="Body"/>
                <ITEXT CH="1. THE COMMON ROOM"/>
                <para PARENT="Heading 2"/>
                <ITEXT CH="[Describe the location. Note the important NPCs, the exits, and anything the characters can interact with. Bold the names of creatures and key items on first mention.]"/>
                <para PARENT="Body"/>
                <ITEXT CH="[Give the DM what they need to run the scene: likely player actions, NPC reactions, and the consequences of success or failure.]"/>
                <para PARENT="Body"/>
                <ITEXT CH="2. THE HEAD GUARD"/>
                <para PARENT="Heading 2"/>
                <ITEXT CH="[The second encounter. Each numbered encounter follows the same rhythm: description, developments, and a pointer to what comes next.]"/>
                <para PARENT="Body"/>
                <ITEXT CH="Sergeant at Arms: AC 16 (chain shirt, shield); HP 11 (2d8 + 2); Speed 30 ft.; STR 13, DEX 12, CON 12, INT 10, WIS 11, CHA 10; Perception +2; Challenge 1/8 (25 XP). Armed with spear and dagger; carries the manor's keys."/>
                <para PARENT="Stat Block"/>
                <ITEXT CH="3. DEVELOPMENTS"/>
                <para PARENT="Heading 2"/>
                <ITEXT CH="[Close the chapter: what happens as a result of the characters' actions, and where the adventure goes from here.]"/>
                <trail PARENT="Body"/>
